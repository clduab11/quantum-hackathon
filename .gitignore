# Hook-created toolkit directory (Blender Toolkit session hook)
.blender-toolkit/

# Competition data and archives: never committed; SHA-256 goes in the ledger
data/
*.zip

# Circuit binaries: never committed; SHA-256 goes in the ledger
*.kmb
candidates/**/*.kmb

# Numpy archives (dfthcsos submission.npz, factorizations, toolbox files): never committed anywhere
# in the tree, whatever the output root; SHA-256 goes in the ledger (PRA-211, PRA-179 item 13)
*.npz

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Status page build output (python -m ledger.status_page; served by Vercel)
public/

# Derived manifest index (python -m ledger.registers index); index-legacy.csv is the frozen log
ledger/manifests/index.csv

# Search loop products (search/README.md): runs hold checkpoints and prompt logs, hand-offs hold circuit binaries
search/runs/
search/handoff/
search/scratch/
