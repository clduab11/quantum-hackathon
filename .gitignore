# Hook-created toolkit directory (Blender Toolkit session hook)
.blender-toolkit/

# Competition data and archives: never committed; SHA-256 goes in the ledger
data/
*.zip

# Circuit binaries: never committed; SHA-256 goes in the ledger
*.kmb
candidates/**/*.kmb

# Large numpy archives under candidates/ (dfthcsos submission.npz and similar)
candidates/**/*.npz
tasks/*/candidates/**/*.npz

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Status page build output (python -m ledger.status_page; served by Vercel)
public/

# Derived manifest index (python -m ledger.registers index); index-legacy.csv is the frozen log
ledger/manifests/index.csv
